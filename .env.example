# ============================================================
# docker compose 用的环境变量
#
#   cp .env.example .env
#   vi .env          # 改掉 DB_PASSWORD / ADMIN_PASSWORD
#   docker compose up -d --build
#
# 这个文件只在宿主机上被 compose 读取，不会打进镜像。
# 生成强密码：openssl rand -base64 15
# ============================================================

# 数据库（app 与 postgres 容器共用，两处必须一致）
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=改成你的数据库密码

# 站长账号：首次启动时若库里没有管理员，用它创建
ADMIN_USER=admin
ADMIN_PASSWORD=改成你的站长密码

# 镜像仓库：CI 推到哪里，服务器就从这里拉
# Docker Hub 示例：dinowritecode/simple-blog
# 阿里云 ACR 示例：registry.cn-chengdu.aliyuncs.com/你的命名空间/simple-blog
IMAGE_REPO=dinowritecode/simple-blog
# latest = 跟主干；也可以填 sha-abc1234 或 v1.2.3 来固定/回退到某个版本
IMAGE_TAG=latest
